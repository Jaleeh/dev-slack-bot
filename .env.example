# Local-only defaults. Copy to .env (make does this for you).
# docker-compose.yml and the Makefile build the database URLs from these values,
# so use URL-safe characters in the user and password.
POSTGRES_USER=devbot
POSTGRES_PASSWORD=devbot
POSTGRES_DB=dev_slack_bot
POSTGRES_HOST_PORT=5432
# Models for evals, in init_chat_model form. An empty EVAL_JUDGE_MODEL grades with CHAT_MODEL.
CHAT_MODEL=ollama:ornith:9b
EVAL_JUDGE_MODEL=ollama:gemma4:e4b
OLLAMA_BASE_URL=http://localhost:11434
